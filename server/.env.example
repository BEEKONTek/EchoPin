# Copy to .env and fill in. Never commit .env.

# PostgreSQL. Use sslmode=require when the database is on another host.
DATABASE_URL=postgresql://echopin:change-me@db:5432/echopin
POSTGRES_PASSWORD=change-me

# Escrow / data / backup keys. Mount a persistent volume here and keep an
# OFFLINE copy: without it sealed logs, 2FA and backups cannot be read.
# KEYS_DIR is set by docker-compose.yml (/data/keys volume). Hosted: use ECHOPIN_KEYS instead.
BACKUPS_DIR=/data/backups

# Mail for verification and reset codes. Without SMTP, codes are printed to
# the server log (development only).
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=echopin@example.org
SMTP_SSL=false

# Behind a reverse proxy (nginx, Caddy, a load balancer) that sets
# X-Forwarded-For. Leave false when the server is exposed directly.
TRUST_PROXY=true
# How many of your proxies append to X-Forwarded-For (the client address
# is that many entries from the right). One nginx/Caddy in front: 1.
TRUSTED_PROXY_HOPS=1
# Or name a header your edge overwrites with the real client address,
# e.g. true-client-ip (Render) or cf-connecting-ip (Cloudflare).
# CLIENT_IP_HEADER=

# Browser origins allowed to call the API (the Flutter web build). Native
# apps need none.
CORS_ORIGINS=

# Daily backup hour (UTC) and how many to keep.
BACKUP_HOUR_UTC=2
BACKUP_RETENTION=14

# ── Hardening (defaults shown) ─────────────────────────────────────────
# Staff (responder/admin) must turn on two-step before using the console.
# REQUIRE_STAFF_TWO_STEP=true
# Refuse passwords found in breaches (k-anonymity: 5 hash chars leave).
# PASSWORD_BREACH_CHECK=true
# Second seal: `echopin_admin init-custodian` prints the public key.
# CUSTODIAN_PUBLIC_KEYS=
# Email every admin when someone opens a session record.
# UNSEAL_ALERTS=true
# Automatic deletion (days; 0 = keep forever). The audit log is kept.
# RETAIN_SESSION_LOGS_DAYS=365
# RETAIN_DIAGNOSTICS_DAYS=90
# RETAIN_CLOSED_REPORTS_DAYS=730
